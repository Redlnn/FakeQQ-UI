{
  "name": "fake-qq-ui",
  "description": "全方位模仿 QQ NT 的聊天气泡样式与功能",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Redlnn",
    "email": "npm@redlnn.top"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Redlnn/FakeQQ-UI"
  },
  "main": "./dist/fake-qq-ui.umd.cjs",
  "module": "./dist/fake-qq-ui.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "directory": "dist"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build-with-check gen-pkg-pson",
    "build-with-check": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "gen-pkg-pson": "node tools/genPackageJson.js"
  },
  "dependencies": {
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.8.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/tsconfig": "^0.5.1",
    "@vueuse/core": "^11.1.0",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.30.0",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.80.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vue-tsc": "^2.1.8"
  },
  "packageManager": "pnpm@9.12.2"
}
